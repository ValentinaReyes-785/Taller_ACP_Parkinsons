      "source": [
        "# Adaptado de: Pacheco (repositorio multivariate)\n",
        "\n",
        "indicadores = function(acp, k, alpha = 3){\n",
        "  f = data.frame(acp$ind$coord[,1:k])\n",
        "  for(j in 1:k){\n",
        "    Q = quantile(f[,j], c(0.25, 0.75))\n",
        "    RIC = diff(Q)\n",
        "    a = min(min(f[,j]), Q[1] - alpha*RIC)\n",
        "    b = max(Q[2] + alpha*RIC, max(f[,j]))\n",
        "    f[,j] = (f[,j] - a)/(b-a)\n",
        "  }\n",
        "  colnames(f) = paste(\"I\", 1:k, sep=\"\")\n",
        "  return(f)\n",
        "}\n",
        "I = indicadores(acp, k = k)\n",
        "head(I, 10)\n",
        "slice_min(I, order_by = I1, n = 5)\n",
        "slice_max(I, order_by = I1, n = 5)\n",
        "ggplot(I, aes(x = I1)) +\n",
        "  geom_histogram(aes(y = after_stat(density)), bins = 10, colour = 1, fill = \"gray\") +\n",
        "  geom_density() + ylab(\"Densidad\") + xlab(\"Indicador I1 (CP1 reescalada a [0,1])\") +\n",
        "  labs(title = \"Distribución del primer indicador\")"
      ],
