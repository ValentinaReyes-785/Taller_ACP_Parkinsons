        "# Adaptado de: Pacheco (repositorio multivariate)\n",
        "\n",
        "# Importación: cada fila es una grabación de voz (name = identificador de la grabación)\n",
        "nombres = c(\"name\",\"Fo\",\"Fhi\",\"Flo\",\"Jitter_pct\",\"Jitter_Abs\",\"Jitter_RAP\",\"Jitter_PPQ\",\"Jitter_DDP\",\n",
        "            \"Shimmer\",\"Shimmer_dB\",\"Shimmer_APQ3\",\"Shimmer_APQ5\",\"Shimmer_APQ\",\"Shimmer_DDA\",\n",
        "            \"NHR\",\"HNR\",\"status\",\"RPDE\",\"DFA\",\"spread1\",\"spread2\",\"D2\",\"PPE\")\n",
        "vars_dup = c(\"Jitter_DDP\",\"Shimmer_DDA\")                 # múltiplos exactos de otras (supl.)\n",
        "vars_todas = setdiff(nombres, c(\"name\",\"status\"))        # 22 variables numéricas\n",
        "vars_voz = setdiff(vars_todas, vars_dup)                 # 20 variables ACTIVAS (p = 20)\n",
        "\n",
        "# Descargamos el dataset directamente de la URL de UCI para evitar el error de archivo inexistente\n",
        "url = \"https://archive.ics.uci.edu/ml/machine-learning-databases/parkinsons/parkinsons.data\"\n",
        "pk = read.csv(url)\n",
        "colnames(pk) = nombres\n",
        "pk = pk %>%\n",
        "  column_to_rownames(\"name\") %>%\n",
        "  mutate(status = factor(status, levels = c(0,1), labels = c(\"Sano\",\"Parkinson\")))\n",
        "\n",
        "# Orden: cualitativa (1), activas (2:21), cuantitativas suplementarias (22:23)\n",
        "datos0 = pk[, c(\"status\", vars_voz, vars_dup)]"
      ],
