        "# Adaptado de: Pacheco (repositorio multivariate)\n",
        "\n",
        "cos2v = Rcv^2\n",
        "ctrv  = apply(Rcv, 2, function(x) x^2/sum(x^2))\n",
        "for(j in 1:k){\n",
        "  cat(\"\\n==== CP\", j, \" (inercia \", round(inercia[j],1), \"%) ====\\n\", sep = \"\")\n",
        "  print(data.frame(Loading = Q[,j], Rcv = Rcv[,j], cos2 = cos2v[,j], ctrv_pct = ctrv[,j]*100,\n",
