      "source": [
        "# Adaptado de: Pacheco (repositorio multivariate)\n",
        "\n",
        "# Atípicos\n",
        "d12 = function(acp, p1, alpha=0.05){\n",
        "  F = acp$ind$coord ; F1 = scale(F)\n",
        "  d1i2 = apply(F1, 1, function(f1) sum(f1[1:p1]^2))\n",
        "  cuantil = qemp(1-alpha, d1i2)\n",
        "  data.frame(Observación = rownames(F), d12 = d1i2, Cuantil = cuantil, Atípico = d1i2 > cuantil)\n",
        "}\n",
        "d22 = function(acp, q, alpha=0.05){\n",
        "  F = acp$ind$coord ; F1 = scale(F) ; pp = ncol(F)\n",
        "  d2i2 = apply(F1, 1, function(f1) sum(f1[(pp-q+1):pp]^2))\n",
        "  cuantil = qemp(1-alpha, d2i2)\n",
        "  data.frame(Observación = rownames(F), d22 = d2i2, Cuantil = cuantil, Atípico = d2i2 > cuantil)\n",
        "}\n",
        "est.d12 = d12(acp, p1 = k)\n",
        "dplyr::filter(est.d12, Atípico == TRUE)\n",
        "ggplot(est.d12, aes(x = seq_along(d12), xend = seq_along(d12), y = 0, yend = d12)) +\n",
        "  geom_segment() + geom_hline(yintercept = est.d12$Cuantil[1], linetype = \"dashed\") +\n",
        "  geom_text(data = dplyr::filter(est.d12, Atípico), aes(x = which(est.d12$Atípico), y = d12, label = Observación),\n",
        "            size = 2, vjust = -1) +\n",
        "  labs(title = \"Estadística d1² (primeras componentes)\", x = \"Observación (índice)\", y = \"d1²\")"
      ],
