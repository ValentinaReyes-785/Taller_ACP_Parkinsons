        "# Adaptado de: Pacheco (repositorio multivariate)\n",
        "\n",
        "# A mano: primer plano principal\n",
        "ggplot(F, aes(x = CP1, y = CP2, label = rownames(F), color = datos$status)) +\n",
        "  geom_point() + geom_text(vjust = -1, size = 2, show.legend = FALSE) +\n",
        "  geom_vline(xintercept = 0, lty = 2) + geom_hline(yintercept = 0, lty = 2) +\n",
        "  scale_color_brewer(palette = \"Set1\") +\n",
        "  labs(title = \"Primer plano principal de las grabaciones de voz\", color = \"Estado\",\n",
        "       x = paste0(\"CP1 (\", round(inercia[1],1), \"%)\"), y = paste0(\"CP2 (\", round(inercia[2],1), \"%)\"))\n",
        "Rcv = cor(Z, F)\n",
        "ggplot(Rcv, aes(x = CP1, y = CP2, label = rownames(Rcv))) +\n",
        "  geom_text(vjust = 1, size = 3) +\n",
        "  geom_vline(xintercept = 0, lty = 2) + geom_hline(yintercept = 0, lty = 2) +\n",
        "  geom_segment(aes(x = 0, y = 0, xend = CP1, yend = CP2), arrow = arrow(length = unit(0.1, \"inches\"))) +\n",
        "  annotate(\"path\", x = cos(seq(0,2*pi,length.out=100)), y = sin(seq(0,2*pi,length.out=100))) +\n",
        "  xlim(c(-1,1)) + ylim(c(-1,1)) + coord_fixed() +\n",
        "  labs(title = \"Círculo de correlaciones (variables de voz)\",\n",
        "       x = paste0(\"CP1 (\", round(inercia[1],1), \"%)\"), y = paste0(\"CP2 (\", round(inercia[2],1), \"%)\"))"
      ],
