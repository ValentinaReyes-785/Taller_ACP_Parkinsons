        "# Adaptado de: Pacheco (repositorio multivariate)\n",
        "\n",
        "# ACP robusto (MVE) y projection-pursuit\n",
        "X_rob = datos[, vars_voz]\n",
        "rob = tryCatch(cov.rob(X_rob, method = \"mve\", cor = TRUE),\n",
        "               error = function(e){ message(\"MVE falló, se usa MCD: \", e$message); cov.rob(X_rob, method = \"mcd\", cor = TRUE) })\n",
        "ev_rob = eigen(rob$cor)\n",
        "v.propios = data.frame(`v. propio` = ev_rob$values, inercia = ev_rob$values/sum(ev_rob$values)*100,\n",
        "                       `iner. acum.` = cumsum(ev_rob$values/sum(ev_rob$values)*100), check.names = FALSE)\n",
        "head(v.propios, 8)\n",
        "scores_rob = scale(X_rob, center = rob$center, scale = sqrt(diag(rob$cov))) %*% ev_rob$vectors\n",
        "ggplot(data.frame(CP1 = scores_rob[,1], CP2 = scores_rob[,2], Estado = datos$status), aes(CP1, CP2, color = Estado)) +\n",
        "  geom_point() + scale_color_brewer(palette = \"Set1\") + labs(title = \"ACP robusto (MVE): CP1 vs CP2\")\n",
        "\n",
        "acp.pp = PCAproj(X_rob, k = 6, method = \"mad\", center = median, scale = mad, maxit = 30)\n",
        "rownames(acp.pp$scores) = rownames(datos)\n",
        "get_eigenvalue(acp.pp)\n",
        "fviz_screeplot(acp.pp) + labs(title = \"Scree plot – projection pursuit\")\n",
        "fviz_pca_ind(acp.pp, axes = c(1,2), geom = c(\"point\",\"text\"), col.ind = datos$status, labelsize = 2,\n",
        "             addEllipses = TRUE, title = \"Individuos – projection pursuit\") + scale_color_brewer(palette = \"Set1\")"
