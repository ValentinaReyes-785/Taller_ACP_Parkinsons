        "# Adaptado de: Pacheco (repositorio multivariate)\n",
        "\n",
        "# Matriz estandarizada y ponderada (solo variables ACTIVAS)\n",
        "Z = datos[, vars_voz] %>%\n",
        "  mutate(across(everything(), function(x) (x-mean(x))/(sd(x)*sqrt(length(x)-1)))) %>%\n",
        "  as.matrix()\n",
        "n = nrow(Z) ; p = ncol(Z) ; n ; p\n",
        "all.equal(t(Z) %*% Z, cor(datos[, vars_voz]), check.attributes = FALSE)   # Z'Z = Rx\n",
        "max(abs(t(Z) %*% Z - Rx))"
      ],
