      "source": [
        "# Adaptado de: Pacheco (repositorio multivariate)\n",
        "\n",
        "all.equal(as.matrix(F), P %*% D, check.attributes = FALSE)            # F = P Delta\n",
        "all.equal(t(Q) %*% Q, diag(p), check.attributes = FALSE)             # Q'Q = I\n",
        "sum(lamb) ; p                                                          # suma = p\n",
        "cbind(var_Fk = apply(F, 2, var), lambda_k = lamb, cociente = apply(F, 2, var)/lamb)\n",
        "round(cor(F)[1:5, 1:5], 6)\n",
        "ev = eigen(Rx)\n",
        "all.equal(ev$values, lamb)\n",
        "round(abs(ev$vectors) - abs(Q), 6)[1:5, 1:5]\n",
        "sign(ev$vectors[1,]) == sign(Q[1,])       # columnas con signo cambiado"
      ],
      "id": "HpY3Vp8XBPmk"
