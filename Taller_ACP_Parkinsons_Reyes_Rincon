      "source": [
        "# Adaptado de: Pacheco (repositorio multivariate)\n",
        "\n",
        "# factoextra: variables por cos2 (suplementarias en azul punteado)\n",
        "for(ejes in list(c(1,2), c(1,3), c(2,3))){\n",
        "  print(fviz_pca_var(acp, axes = ejes, col.var = \"cos2\", repel = TRUE,\n",
        "                     title = paste0(\"Variables de voz – CP\", ejes[1], \" vs CP\", ejes[2])) +\n",
        "    scale_color_gradient2(low = \"red\", mid = \"blue\", high = \"black\", midpoint = .3))\n",
        "}\n",
        "cs = lapply(1:k, function(j) fviz_contrib(acp, choice = \"var\", axes = j, title = paste0(\"CP\", j)) + ylab(\"Contribuciones (%)\"))\n",
        "do.call(grid.arrange, c(cs, list(ncol = 2)))"
